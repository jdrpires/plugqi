{
  "info": {
    "name": "PlugQi - Full Integration Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection covering Risk Solution, Webhook, Escrow flows and common helpers"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "{{api_key}}" } ],
        "url": "{{base_url}}/test",
        "body": { "mode": "raw", "raw": "{ \"name\": \"QI Tech\" }" }
      }
    },
    {
      "name": "Risk - Send Natural Person",
      "request": {
        "method": "POST",
        "header": [ { "key": "Authorization", "value": "{{api_key}}" }, { "key": "Content-Type", "value": "application/json" } ],
        "url": "{{base_url}}/natural_person?analyze={{analyze}}",
        "body": { "mode": "raw", "raw": "{\n  \"registration_id\": \"reg-12345\",\n  \"document_number\": \"123.456.789-12\",\n  \"name\": \"Fulano\"\n}" }
      }
    },
    {
      "name": "Risk - Send Legal Person",
      "request": {
        "method": "POST",
        "header": [ { "key": "Authorization", "value": "{{api_key}}" }, { "key": "Content-Type", "value": "application/json" } ],
        "url": "{{base_url}}/legal_person?analyze={{analyze}}",
        "body": { "mode": "raw", "raw": "{\n  \"registration_id\": \"reg-12345\",\n  \"document_number\": \"08.104.627/0001-02\"\n}" }
      }
    },
    {
      "name": "Risk - Get Natural Person",
      "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "{{api_key}}" } ], "url": "{{base_url}}/natural_person/{{person_id}}" }
    },
    {
      "name": "Webhook - POST local",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Signature", "value": "{{webhook_signature}}" } ],
        "url": "{{webhook_url}}",
        "body": { "mode": "raw", "raw": "{\n  \"registration_id\": \"reg-12345\",\n  \"natural_person_id\": \"np-999\",\n  \"analysis_status\": \"APPROVED\",\n  \"event_date\": \"2026-01-08T12:02:41Z\",\n  \"reason\": \"Análise automatizada OK\"\n}" }
      }
    },
    {
      "name": "Webhook - GET status",
      "request": { "method": "GET", "url": "{{status_url}}?id_registro=reg-12345" }
    },
    {
      "name": "Escrow - Create PF reservation",
      "request": {
        "method": "POST",
        "header": [ { "key": "Authorization", "value": "{{api_key}}" }, { "key": "Content-Type", "value": "application/json" } ],
        "url": "{{api_base}}/account_request/escrow",
        "body": { "mode": "raw", "raw": "{\n  \"account_owner\": { \"document_number\": \"99999999999\", \"email\": \"teste@example.com\", \"name\": \"Teste\" }\n}" }
      }
    },
    {
      "name": "Escrow - Create PJ reservation",
      "request": {
        "method": "POST",
        "header": [ { "key": "Authorization", "value": "{{api_key}}" }, { "key": "Content-Type", "value": "application/json" } ],
        "url": "{{api_base}}/account_request/escrow/legal",
        "body": { "mode": "raw", "raw": "{\n  \"account_owner\": { \"company_document_number\": \"08.104.627/0001-02\", \"email\": \"contato@empresa.example\", \"name\": \"Empresa\" }\n}" }
      }
    },
    {
      "name": "Escrow - Confirm reservation (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [ { "key": "Authorization", "value": "{{api_key}}" }, { "key": "Content-Type", "value": "application/json" } ],
        "url": "{{api_base}}/account_request/{{account_request_key}}/escrow",
        "body": { "mode": "raw", "raw": "{\n  \"signed_contract\": { \"document_key\": \"<uuid>\" }, \n  \"account_owner\": { \"name\": \"Fulano\" }\n}" }
      }
    }
  ],
  "variable": [
    { "key": "api_key", "value": "EXAMPLE-OF-API-KEY" },
    { "key": "base_url", "value": "https://api.sandbox.caas.qitech.app/onboarding" },
    { "key": "api_base", "value": "https://api.sandbox.caas.qitech.app" },
    { "key": "webhook_url", "value": "http://localhost:8000/webhooks/qitech/onboarding" },
    { "key": "status_url", "value": "http://localhost:8000/webhooks/qitech/status" },
    { "key": "webhook_secret", "value": "change-me" },
    { "key": "analyze", "value": "false" }
  ]
}
