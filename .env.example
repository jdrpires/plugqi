### Example .env for the Plugz orchestrator
# Qitech sandbox API key (do not commit real keys)
QITECH_API_KEY=your-qitech-api-key-here

# Base URL used to build white-labeled redirect links
# In production set to your public Plugz domain (https://app.plugz.example)
PLUGZ_BASE_URL=http://localhost:8000

# Optional: PORT for uvicorn
PORT=8000

# Optional: upload endpoint (override if different)
QITECH_UPLOAD_URL=https://api.sandbox.caas.qitech.app/documents/upload
