	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global pre-request script: if use_local_proxy=true, call local helper to generate JWT",
					"if (pm.environment.get('use_local_proxy') === 'true') {",
						"var local = pm.environment.get('local_proxy_url') || 'http://localhost:5000';",
						"var endpoint = '/';",
						"try {",
							"if (pm.request && pm.request.url) {",
								"// Try to build path; fallbacks handled below",
								"if (pm.request.url.getPath) endpoint = pm.request.url.getPath();",
								"if (!endpoint && pm.request.url.path) endpoint = '/' + pm.request.url.path.join('/');",
								"// Append querystring if present",
								"if (pm.request.url.query && pm.request.url.query.count && pm.request.url.query.count() > 0) {",
									"var q = pm.request.url.query.toObject();",
									"var pairs = [];",
									"for (var k in q) { if (q.hasOwnProperty(k)) pairs.push(k + '=' + q[k]); }",
									"if (pairs.length) endpoint += '?' + pairs.join('&');",
								"}",
							"}",
						"} catch(e) { endpoint = '/'; }",
						"var bodyObj = {};",
						"if (pm.request && pm.request.body && pm.request.body.raw) {",
							"try { bodyObj = JSON.parse(pm.request.body.raw); } catch(e) { bodyObj = {}; }",
						"}",
						"pm.sendRequest({",
							"url: local + '/__generate_auth',",
							"method: 'POST',",
							"header: { 'Content-Type': 'application/json' },",
							"body: { mode: 'raw', raw: JSON.stringify({ method: pm.request ? pm.request.method : 'GET', endpoint: endpoint, body: bodyObj }) }",
						"}, function (err, res) {",
							"if (err) { console.log('Erro ao gerar auth:', err); return; }",
							"var hdrs = (res && res.json && res.json().headers) ? res.json().headers : {};",
							"if (hdrs.AUTHORIZATION) pm.environment.set('jwt_token', hdrs.AUTHORIZATION);",
							"if (hdrs['API-CLIENT-KEY']) pm.environment.set('QITECH_CLIENT_KEY', hdrs['API-CLIENT-KEY']);",
						"});",
					"}",
					"// If not using local proxy, ensure jwt_token is set manually in environment",
				]
			}
		},
